# Build output
dist/
coverage/

# Dependencies
node_modules/

# The process machinery: never committed, never linted.
/.gate-logs/
/.gate-lock/
/worktrees/

# Local scratch
*.local
.DS_Store

# Headless-browser profiles from a boot check. The kill+remove happens in a trap,
# but Chrome recreates its profile while shutting down, so a raced cleanup can leave
# one behind — and scratch must never be committable.
/.browser-scratch-*/
